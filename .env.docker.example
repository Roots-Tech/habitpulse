# HabitPulse Production Environment Variables for Docker
# Copy this file to .env.docker before running docker compose:
# cp .env.docker.example .env.docker

# Django Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production-min-50-chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,web,yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001,https://yourdomain.com
TIME_ZONE=Asia/Kolkata

# PostgreSQL Container Credentials
DB_NAME=habit_tracker
DB_USER=habit_user
DB_PASSWORD=habit_secure_password_123
DB_HOST=db
DB_PORT=5432

# Application Port
PORT=8000

# Ollama Local AI Semantic Classifier
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_PORT=11434
